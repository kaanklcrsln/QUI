      "normal": {
        "background": "#00000000",
        "color": "#ffffff",
        "padding": [
          4,
          10,
          4,
          10
        ]
      },
      "hover": {
        "background": "#333333"
      },
      "pressed": {
        "background": "@accent",
        "color": "#000000"
      },
      "disabled": {
        "color": "#a0a0a0"
      }
    },
    "menu": {
      "normal": {
        "background": "#000000",
        "color": "#ffffff",
        "border_color": "#ffffff",
        "border_width": 2
      }
    },
    "menu.item": {
      "normal": {
        "background": "#00000000",
        "color": "#ffffff"
      },
      "hover": {
        "background": "@accent",
        "color": "#000000"
      },
      "disabled": {
        "color": "#a0a0a0"
      }
    },
    "toolbar": {
      "normal": {
        "background": "#000000",
        "border_width": 0
      }
    },
    "toolbar.button": {
      "normal": {
        "background": "#00000000",
        "border_width": 0,
        "border_radius": 0,
        "padding": [
          3,
          3,
          3,
          3
        ]
      },
      "hover": {
        "background": "#333333"
      },
      "pressed": {
        "background": "#555555"
      },
      "checked": {
        "background": "@accent"
      }
    },
    "dock": {
      "normal": {
        "background": "#000000",
        "color": "#ffffff"
      }
    },
    "dock.title": {
      "normal": {
        "background": "#000000",
        "color": "#ffffff",
        "padding": [
          5,
          8,
          5,
          8
        ]
      }
    },
    "statusbar": {
      "normal": {
        "background": "#000000",
        "color": "#ffffff"
      }
    },
    "statusbar.text": {
      "normal": {
        "color": "#ffffff"
      }
    },
    "dialog": {
      "normal": {
        "background": "#000000",
        "color": "#ffffff"
      }
    },
    "dialog.page_list": {
      "normal": {
        "background": "#000000",
        "color": "#ffffff",
        "border_width": 0
      }
    },
    "dialog.page_list.item": {
      "normal": {
        "padding": [
          6,
          8,
          6,
          8
        ]
      },
      "hover": {
        "background": "#333333"
      },
      "selected": {
        "background": "@accent",
        "color": "#000000"
      }
    }
  }
}
