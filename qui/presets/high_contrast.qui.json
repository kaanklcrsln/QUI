    },
    "item_view.item": {
      "hover": {
        "background": "#333333"
      },
      "selected": {
        "background": "@accent",
        "color": "#000000"
      }
    },
    "item_view.header": {
      "normal": {
        "background": "#000000",
        "color": "#ffffff",
        "border_width": 0,
        "padding": [
          4,
          6,
          4,
          6
        ]
      }
    },
    "tooltip": {
      "normal": {
        "background": "#000000",
        "color": "#ffffff",
        "border_color": "#ffffff",
        "border_width": 2
