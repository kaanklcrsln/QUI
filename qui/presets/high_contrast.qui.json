{
  "schema": 1,
  "name": "High Contrast",
  "base_ui_theme": "default",
  "global": {
    "accent": "#ffd400",
    "radius": 0,
    "opacity": 1.0
  },
  "font": {},
  "components": {
    "label": {
      "normal": {
        "color": "#ffffff"
      },
      "disabled": {
        "color": "#a0a0a0"
      }
    },
    "input": {
      "normal": {
        "background": "#000000",
        "color": "#ffffff",
        "border_color": "#ffffff",
        "border_width": 2,
        "border_radius": 0,
        "padding": [
          3,
          6,
          3,
          6
        ]
      },
      "hover": {
        "border_color": "#ffffff"
      },
      "disabled": {
        "background": "#000000",
        "color": "#a0a0a0"
      }
    },
    "combo": {
      "normal": {
        "background": "#000000",
        "color": "#ffffff",
        "border_color": "#ffffff",
        "border_width": 2,
        "border_radius": 0,
        "padding": [
          3,
          6,
          3,
          6
        ]
      },
      "hover": {
        "border_color": "#ffffff"
      },
      "disabled": {
        "background": "#000000",
        "color": "#a0a0a0"
      }
    },
    "button": {
      "normal": {
        "background": "#000000",
        "color": "#ffffff",
        "border_color": "#ffffff",
        "border_width": 2,
        "border_radius": 0,
        "padding": [
          4,
          14,
          4,
          14
        ]
      },
      "hover": {
        "background": "#333333"
      },
      "pressed": {
        "background": "#555555"
      },
      "checked": {
        "background": "@accent",
        "color": "#000000"
      },
      "disabled": {
        "color": "#a0a0a0"
      }
    },
    "tab": {
      "normal": {
        "background": "#000000",
        "color": "#ffffff",
        "border_width": 0,
        "padding": [
          6,
          14,
          6,
          14
        ]
      },
      "hover": {
        "color": "#ffffff"
      },
      "selected": {
        "background": "#000000",
        "color": "@accent"
      },
      "disabled": {
        "color": "#a0a0a0"
      }
    },
    "tab_pane": {
      "normal": {
        "background": "#000000",
        "border_color": "#ffffff",
        "border_width": 2
      }
    },
    "scroll_area": {
      "normal": {
        "background": "#00000000",
        "border_width": 0
      }
    },
    "group_box": {
      "normal": {
        "color": "#ffffff"
      }
    },
    "group_box.title": {
      "normal": {
        "color": "#ffffff"
      }
    },
    "item_view": {
      "normal": {
        "background": "#000000",
        "color": "#ffffff",
        "border_color": "#ffffff",
        "border_width": 2,
        "border_radius": 0
